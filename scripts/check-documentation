#!/usr/bin/env python3
"""Fail closed when the production handoff package drifts from the application."""

from __future__ import annotations

import json
import re
import subprocess
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent

REQUIRED_DOCUMENTS = (
    "README.md",
    "docs/architecture/overview.md",
    "docs/architecture/state-machines.md",
    "docs/architecture/security-boundaries.md",
    "docs/api/README.md",
    "docs/api/openapi.json",
    "docs/deployment/production.md",
    "docs/deployment/credential-ownership.md",
    "docs/operations/incident-response.md",
    "docs/operations/known-risks.md",
    "docs/handoff/asset-register.md",
    "docs/handoff/training.md",
    "docs/handoff/acceptance.md",
    "docs/scope/change-control.md",
    "docs/readiness/checklist.md",
)

REQUIRED_CHAT_STATES = frozenset(
    {"AI_ACTIVE", "HANDOFF_REQUESTED", "QUEUED", "HUMAN_ACTIVE", "RESOLVED"}
)
REQUIRED_EMAIL_STATES = frozenset(
    {
        "INGESTED",
        "DRAFTING",
        "DRAFT_RETRY_WAIT",
        "AWAITING_REVIEW",
        "APPROVED",
        "SEND_PENDING",
        "SENDING",
        "SENT",
        "REJECTED",
        "SEND_RETRY_WAIT",
        "DELIVERY_UNKNOWN",
        "FAILED_TERMINAL",
    }
)
REQUIRED_HANDOFF_ASSET_MARKERS = (
    "Repository and release tags",
    "Container images and deployment scripts",
    "VM, DNS, and TLS",
    "PostgreSQL, backups, KMS, and monitoring",
    "Google Cloud project, Drive/Gmail identities, and OAuth clients",
    "Claude and OpenAI accounts, budgets, and usage alerts",
    "Data migrations, API documents, state machines, architecture, and security guidance",
    "Tests, regression and acceptance sets, evaluations, and cost/latency baselines",
    "PITR, RPO/RTO, Redis recovery, Gmail reconciliation, and erasure replay evidence",
    "Runbooks, incident response, known risks, and administrator training",
)
SECURITY_CLASSIFICATIONS = frozenset({"public", "staff", "administrator", "internal"})


def _read(relative_path: str) -> str:
    return (ROOT / relative_path).read_text(encoding="utf-8")


def _environment_names() -> set[str]:
    return {
        line.partition("=")[0]
        for line in _read(".env.example").splitlines()
        if line and not line.startswith("#") and "=" in line
    }


def _check_documents(failures: list[str]) -> None:
    missing = [path for path in REQUIRED_DOCUMENTS if not (ROOT / path).is_file()]
    if missing:
        failures.append(f"missing documents: {', '.join(missing)}")


def _check_openapi(failures: list[str]) -> None:
    path = ROOT / "docs/api/openapi.json"
    if not path.is_file():
        return
    try:
        schema = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        failures.append(f"invalid OpenAPI JSON: {error.msg}")
        return
    if not isinstance(schema, dict):
        failures.append("invalid OpenAPI root")
        return
    paths = schema.get("paths")
    components = schema.get("components")
    security_schemes = components.get("securitySchemes") if isinstance(components, dict) else None
    if not isinstance(paths, dict):
        failures.append("OpenAPI paths missing")
        return
    if not isinstance(security_schemes, dict) or not {"StaffSession", "PublicChatCredential"} <= set(
        security_schemes
    ):
        failures.append("OpenAPI security definitions missing")
    required_groups = {
        "public": "/api/v1/public/",
        "staff": "/api/v1/staff/",
        "administrator": "/api/v1/admin/",
        "health": "/health/",
        "metrics": "/metrics",
    }
    present_groups = {
        name
        for name, prefix in required_groups.items()
        if any(route.startswith(prefix) for route in paths)
    }
    missing_groups = sorted(set(required_groups) - present_groups)
    if missing_groups:
        failures.append(f"OpenAPI endpoint groups missing: {', '.join(missing_groups)}")
    for route, operations in paths.items():
        if not isinstance(operations, dict):
            continue
        for method, operation in operations.items():
            if method not in {"get", "post", "put", "patch", "delete"}:
                continue
            if not isinstance(operation, dict):
                failures.append(f"OpenAPI operation invalid: {method.upper()} {route}")
                continue
            classification = operation.get("x-security-classification")
            if classification not in SECURITY_CLASSIFICATIONS:
                failures.append(f"OpenAPI security classification missing: {method.upper()} {route}")


def _check_state_machines(failures: list[str]) -> None:
    path = ROOT / "docs/architecture/state-machines.md"
    if not path.is_file():
        return
    documented = set(re.findall(r"`([A-Z][A-Z0-9_]+)`", path.read_text(encoding="utf-8")))
    missing_chat = sorted(REQUIRED_CHAT_STATES - documented)
    missing_email = sorted(REQUIRED_EMAIL_STATES - documented)
    if missing_chat:
        failures.append(f"chat states missing: {', '.join(missing_chat)}")
    if missing_email:
        failures.append(f"email states missing: {', '.join(missing_email)}")


def _check_environment_registry(failures: list[str]) -> None:
    path = ROOT / "docs/deployment/credential-ownership.md"
    if not path.is_file():
        return
    rows = {
        match.group("name"): (match.group("owner").strip(), match.group("description").strip())
        for match in re.finditer(
            r"^\|\s*`(?P<name>[A-Z][A-Z0-9_]+)`\s*\|\s*(?P<owner>[^|]*)\|\s*(?P<description>[^|]*)\|\s*$",
            path.read_text(encoding="utf-8"),
            flags=re.MULTILINE,
        )
    }
    missing = sorted(name for name in _environment_names() if name not in rows)
    incomplete = sorted(name for name, fields in rows.items() if not all(fields))
    if missing:
        failures.append(f"environment ownership missing: {', '.join(missing)}")
    if incomplete:
        failures.append(f"environment ownership incomplete: {', '.join(incomplete)}")


def _operability_runbooks(failures: list[str]) -> set[str]:
    result = subprocess.run(
        [str(ROOT / "scripts/check-operability"), "--compose-file", "compose.yaml"],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        failures.append("operability output unavailable")
        return set()
    try:
        report: dict[str, Any] = json.loads(result.stdout)
    except json.JSONDecodeError:
        failures.append("operability output is not JSON")
        return set()
    systems = report.get("systems", [])
    if not isinstance(systems, list):
        failures.append("operability systems missing")
        return set()
    return {
        str(item["runbook"])
        for item in systems
        if isinstance(item, dict) and isinstance(item.get("runbook"), str)
    }


def _check_runbook_links(failures: list[str]) -> None:
    runbooks = _operability_runbooks(failures)
    if not runbooks:
        return
    incident_path = ROOT / "docs/operations/incident-response.md"
    incident_text = incident_path.read_text(encoding="utf-8") if incident_path.is_file() else ""
    missing = []
    for runbook in sorted(runbooks):
        if not (ROOT / runbook).is_file() or runbook not in incident_text:
            missing.append(runbook)
    if missing:
        failures.append(f"operability runbook links missing: {', '.join(missing)}")


def _check_handoff_assets(failures: list[str]) -> None:
    path = ROOT / "docs/handoff/asset-register.md"
    if not path.is_file():
        return
    content = path.read_text(encoding="utf-8")
    missing = [marker for marker in REQUIRED_HANDOFF_ASSET_MARKERS if marker not in content]
    if missing:
        failures.append(f"handoff assets missing: {', '.join(missing)}")


def _check_cross_links(failures: list[str]) -> None:
    checks = {
        "README handoff links": (
            "README.md",
            ("docs/deployment/production.md", "docs/handoff/acceptance.md", "docs/api/README.md"),
        ),
        "readiness evidence links": (
            "docs/readiness/checklist.md",
            (
                "docs/evidence/release/final-local-verification.json",
                "docs/evidence/recovery/local-verification.json",
                "docs/handoff/acceptance.md",
            ),
        ),
        "scope cut line": ("docs/scope/change-control.md", ("scope freeze", "cut line")),
        "acceptance rotation": (
            "docs/handoff/acceptance.md",
            ("credential rotation", "developer access"),
        ),
    }
    for label, (path, required) in checks.items():
        document = ROOT / path
        if not document.is_file():
            continue
        content = document.read_text(encoding="utf-8").casefold()
        absent = [token for token in required if token.casefold() not in content]
        if absent:
            failures.append(f"{label} missing: {', '.join(absent)}")


def main() -> int:
    failures: list[str] = []
    _check_documents(failures)
    _check_openapi(failures)
    _check_state_machines(failures)
    _check_environment_registry(failures)
    _check_runbook_links(failures)
    _check_handoff_assets(failures)
    _check_cross_links(failures)
    print(json.dumps({"status": "FAIL" if failures else "PASS", "failures": failures}, indent=2))
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
