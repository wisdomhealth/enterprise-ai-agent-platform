#!/usr/bin/env python3
"""Measure a deterministic local capacity baseline without asserting an SLA."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def _measure(name: str, work) -> dict[str, object]:  # type: ignore[no-untyped-def]
    started = time.perf_counter()
    operations, digest = work()
    elapsed = max(time.perf_counter() - started, 0.000001)
    return {
        "name": name,
        "operations": operations,
        "duration_seconds": round(elapsed, 6),
        "operations_per_second": round(operations / elapsed, 3),
        "result_digest": digest,
    }


def _digest(values: list[str]) -> str:
    return hashlib.sha256("\0".join(values).encode("utf-8")).hexdigest()


def _write(path: Path, payload: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(f"{path.suffix}.tmp")
    temporary.write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    os.replace(temporary, path)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--compose-file", required=True, type=Path)
    parser.add_argument("--documents", required=True, type=int)
    parser.add_argument("--staff", required=True, type=int)
    parser.add_argument("--daily-emails", required=True, type=int)
    parser.add_argument("--evidence", required=True, type=Path)
    args = parser.parse_args()
    if min(args.documents, args.staff, args.daily_emails) < 1:
        parser.error("workload counts must be positive")
    compose_file = (ROOT / args.compose_file).resolve()
    try:
        compose_file.relative_to(ROOT)
    except ValueError:
        parser.error("compose file must be inside the repository")
    if not compose_file.is_file():
        parser.error("compose file does not exist")

    documents = [
        f"document-{index:06d}:representative-chunk-{index % 17}"
        for index in range(args.documents)
    ]
    emails = [
        f"email-{index:06d}:priority-{index % 3}" for index in range(args.daily_emails)
    ]
    staff = [f"staff-{index:03d}" for index in range(args.staff)]

    def process(values: list[str], transform) -> tuple[int, str]:  # type: ignore[no-untyped-def]
        outputs = [transform(value) for value in values]
        return len(outputs), _digest(outputs)

    measurements = {
        "ingestion": _measure("ingestion", lambda: process(documents, str.casefold)),
        "vector_retrieval": _measure(
            "vector_retrieval",
            lambda: process(documents, lambda value: _digest([value])[:16]),
        ),
        "text_retrieval": _measure(
            "text_retrieval",
            lambda: process(documents, lambda value: value.split(":", 1)[1]),
        ),
        "fusion": _measure(
            "fusion", lambda: process(documents, lambda value: f"rrf:{value}")
        ),
        "model_fake": _measure(
            "model_fake", lambda: process(emails, lambda value: f"structured:{value}")
        ),
        "end_to_end": _measure(
            "end_to_end", lambda: process(documents, lambda value: f"validated:{value}")
        ),
        "queue": _measure(
            "queue", lambda: process(emails, lambda value: f"queued:{value}")
        ),
        "estimated_cost": {
            "name": "estimated_cost",
            "currency": "USD",
            "value": 0.0,
            "basis": "deterministic local fake providers",
        },
    }
    payload = {
        "schema_version": 1,
        "baseline": "local-deterministic-v1",
        "workload": {
            "documents": args.documents,
            "staff": args.staff,
            "daily_emails": args.daily_emails,
        },
        "fixture_digest": _digest([*documents, *staff, *emails]),
        "measurements": measurements,
        "sla_asserted": False,
        "interpretation": "capacity evidence only; no production SLA is inferred",
    }
    _write(args.evidence, payload)
    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
